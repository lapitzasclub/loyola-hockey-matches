{
  "name": "loyola-hockey-matches",
  "version": "2.0.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Loyola Hockey Matches v2: partidos, clasificación y directo de los equipos del Loyola (PWA + Android).",
  "scripts": {
    "start": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:capture": "node scripts/capture-fixtures.ts",
    "e2e": "playwright test",
    "cap:copy": "npx cap copy",
    "cap:sync": "npx cap sync",
    "android:sync": "npm run build && npx cap sync android",
    "android:run": "npm run android:sync && npx cap run android",
    "android:open": "npx cap open android",
    "cf:dev": "npm run build && npx wrangler pages dev dist",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/status-bar": "^7.0.6",
    "@capgo/capacitor-navigation-bar": "^7.3.18",
    "@ionic/react": "^9.0.10",
    "@ionic/react-router": "^9.0.10",
    "@tanstack/react-query": "^5.105.0",
    "i18next": "^26.5.12",
    "ionicons": "^8.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "react-router": "^6.30.6",
    "react-router-dom": "^6.30.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
